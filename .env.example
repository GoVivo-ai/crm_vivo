# Neon Postgres (vía Vercel Marketplace: vercel env pull)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Email del primer admin: entra con role=admin y active=true; el resto de
# usuarios nace inactivo hasta que un admin lo active.
INITIAL_ADMIN_EMAIL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Crons
CRON_SECRET=

# Master key del cifrado de credenciales de integraciones (32 bytes hex,
# 64 caracteres — genera con: openssl rand -hex 32)
CREDENTIALS_ENCRYPTION_KEY=

# Origin canonico de la app (produccion: https://erp.govivo.ai) — usado
# para construir los redirect URIs de OAuth
NEXT_PUBLIC_APP_URL=

# Apps OAuth (secretos de la APLICACION, no del usuario): quickbooks,
# meta_ads y clickup se conectan con boton Conectar
# (/api/oauth/[provider]/start; redirect URI de produccion:
# https://erp.govivo.ai/api/oauth/{provider}/callback)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

# FALLBACK OPCIONAL: las credenciales se gestionan desde la app
# (settings/integrations, cifradas en BD). Estas env vars solo se usan
# si no hay credenciales guardadas en BD.
QBO_ACCESS_TOKEN=
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
META_ADS_ACCESS_TOKEN=
META_ADS_BUSINESS_ID=
CLICKUP_TOKEN=
