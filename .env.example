# Neon Postgres (vía Vercel Marketplace: vercel env pull)
DATABASE_URL=

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Email del primer admin: entra con role=admin y active=true; el resto de
# usuarios nace inactivo hasta que un admin lo active.
INITIAL_ADMIN_EMAIL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Crons
CRON_SECRET=

# Master key del cifrado de credenciales de integraciones (32 bytes hex,
# 64 caracteres — genera con: openssl rand -hex 32)
CREDENTIALS_ENCRYPTION_KEY=

# FALLBACK OPCIONAL: las credenciales de integraciones se gestionan desde
# la app (settings/integrations, cifradas en BD). Estas env vars solo se
# usan si no hay credenciales guardadas en BD.
ALEGRA_EMAIL=
ALEGRA_API_TOKEN=
WINDSOR_API_KEY=
CLICKUP_TOKEN=
